# Copy to .env.local for local overrides. No real secrets here.

# Forces a data state for testing (D-13): openmeteo-down | metno-down | stale | empty
# Ignored in production (VERCEL_ENV=production). Leave empty for normal behaviour.
WEATHER_FAULT=

# Optional override of the upstream User-Agent (repo URL only; no email).
WEATHER_USER_AGENT=
